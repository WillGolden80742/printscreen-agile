{
  "manifest_version": 3,
  "name": "Printscreen Agile — Fluxo de Print",
  "short_name": "PrintAgile",
  "description": "Arraste o mouse nos elementos (borda vermelha), clique para salvar vários, clique+arraste gera seta. No final capture página inteira ou arraste e selecione.",
  "version": "1.9.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Printscreen Agile",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/html-to-image.min.js",
        "src/icons.js",
        "src/store.js",
        "src/overlay.js",
        "src/chrome.js",
        "src/crop.js",
        "src/editor.js",
        "src/capture.js",
        "src/flow.js",
        "src/bootstrap.js"
      ],
      "css": ["fonts/mdi.css", "content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
